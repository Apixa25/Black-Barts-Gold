# ============================================================
# Black Bart's Gold MCP Server — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Base URL of the deployed admin dashboard (no trailing slash)
# - Local dev:   http://localhost:3000
# - Production:  https://your-bbg-admin.vercel.app
ADMIN_API_BASE_URL=http://localhost:3000

# API key the MCP server sends in every request to the admin API
# Must match the AI_AGENT_API_KEY value set in the admin-dashboard .env
# Generate a strong random value: openssl rand -hex 32
AI_AGENT_API_KEY=change-me-to-a-strong-secret
